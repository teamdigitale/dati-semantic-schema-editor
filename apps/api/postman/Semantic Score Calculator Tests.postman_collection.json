    {
      "name": "api istat - cors",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CORS - header Access-Control-Allow-Origin presente', function () {",
              "  pm.expect(pm.response.headers.has('Access-Control-Allow-Origin'), 'atteso header Access-Control-Allow-Origin').to.be.true;",
              "});",
              "",
              "pm.test('CORS - Access-Control-Allow-Methods include GET e POST', function () {",
              "  var methods = (pm.response.headers.get('Access-Control-Allow-Methods') || '').toUpperCase();",
              "  pm.expect(methods).to.include('GET');",
              "  pm.expect(methods).to.include('POST');",
              "});",
              "",
              "pm.test('CORS - Access-Control-Allow-Origin coerente con Origin richiesto o wildcard', function () {",
              "  var acao = pm.response.headers.get('Access-Control-Allow-Origin') || '';",
              "  var origin = pm.variables.get('corsOrigin');",
              "  pm.expect(acao === '*' || acao === origin, 'ACAO=' + acao + ' atteso \"*\" o \"' + origin + '\"').to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "{{corsOrigin}}"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "Content-Type, Accept"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        },
        "description": "Preflight CORS (OPTIONS) verso /status: verifica gli header Access-Control-Allow-*. Il valore di ACAO dipende da CORS_ORIGIN lato server (default *)."
      },
      "response": []
    },
    {
      "name": "api istat - rate limiting",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Invia richieste ripetute a /status finche' non si ottiene un 429",
              "// (oppure fino a rateLimitMaxAttempts). Self-contained: funziona anche con \"Send\".",
              "var base = pm.variables.get('baseUrl');",
              "var maxAttempts = parseInt(pm.variables.get('rateLimitMaxAttempts') || '40', 10);",
              "var attempt = 0;",
              "",
              "function fire() {",
              "  attempt++;",
              "  pm.sendRequest({ url: base + '/status', method: 'GET' }, function (err, res) {",
              "    if (err) {",
              "      pm.test('Rate limiting - nessun errore di rete', function () {",
              "        pm.expect.fail('Errore di rete: ' + err);",
              "      });",
              "      return;",
              "    }",
              "    if (res.code === 429) {",
              "      pm.test('Rate limiting - ricevuto 429 Too Many Requests (dopo ' + attempt + ' richieste)', function () {",
              "        pm.expect(res.code).to.eql(429);",
              "      });",
              "      pm.test('Rate limiting - il 429 espone header di throttling', function () {",
              "        var h = res.headers;",
              "        var has = h.has('Retry-After') || h.has('X-RateLimit-Limit') || h.has('X-RateLimit-Remaining') || h.has('X-RateLimit-Reset');",
              "        pm.expect(has, 'atteso almeno uno tra Retry-After / X-RateLimit-*').to.be.true;",
              "      });",
              "      return;",
              "    }",
              "    if (attempt >= maxAttempts) {",
              "      pm.test('Rate limiting - raggiunto 429 entro ' + maxAttempts + ' tentativi', function () {",
              "        pm.expect.fail('Nessun 429 dopo ' + attempt + ' richieste. Aumenta rateLimitMaxAttempts o verifica il throttling lato server (default 15/60s).');",
              "      });",
              "      return;",
              "    }",
              "    fire();",
              "  });",
              "}",
              "",
              "fire();"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        },
        "description": "Verifica il rate limiting: invia molte richieste a /status finche' non scatta un 429 (default server 15/60s). Cap configurabile via rateLimitMaxAttempts."
      },
      "response": []
    }
