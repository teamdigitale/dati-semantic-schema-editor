{
  "info": {
    "_postman_id": "5ef8bf58-469b-444f-9e7d-f17279100ebf",
    "name": "Semantic Score Calculator Tests",
    "description": "## Test della API Semantic Score Calculator (apps/api)\n\nQuesta collection testa attivamente l'API `apps/api` (NestJS) deployata in produzione,\na partire dall'OpenAPI dell'API. Il path reale e' `<host>/api/v1`.\n\nImposta la variabile di collection `baseUrl` sull'host di produzione reale\n(es. `https://<host>/api/v1`). Il valore di default e' un placeholder.\n\nLe richieste verso `/semantic-score` caricano file dalla cartella `fixtures/`:\nin Postman/Newman imposta la **working directory** su `apps/api/postman/`.\n\nCasi testati:\n1. api istat - healthcheck\n2. api istat - file annotato\n3. api istat - file non annotato\n4. api istat - file non supportato\n5. api istat - file con errori (openapi 3.1.0)\n6. api istat - disabilitazione swagger in produzione\n7. api istat - cors\n8. api istat - rate limiting",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "44944933"
  },
  "item": [
    {
      "name": "api istat - healthcheck",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Healthcheck - status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Healthcheck - Content-Type application/json', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "});",
              "",
              "pm.test('Healthcheck - body { status: 200, title: \"OK\" }', function () {",
              "  var body = pm.response.json();",
              "  pm.expect(body).to.have.property('status', 200);",
              "  pm.expect(body).to.have.property('title', 'OK');",
              "});",
              "",
              "pm.test('Healthcheck - header X-RateLimit-* presenti (soft)', function () {",
              "  var h = pm.response.headers;",
              "  var present = h.has('X-RateLimit-Limit') || h.has('X-RateLimit-Remaining') || h.has('X-RateLimit-Reset');",
              "  if (!present) {",
              "    console.warn('Header X-RateLimit-* non presenti sulla 200 (configurazione throttler lato server).');",
              "  }",
              "  pm.expect(true).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        },
        "description": "Verifica che il servizio sia attivo (GET /status)."
      },
      "response": []
    },
    {
      "name": "api istat - file annotato",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('File annotato - status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('File annotato - Content-Type application/json', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
              "});",
              "",
              "var body = pm.response.json();",
              "",
              "pm.test('File annotato - score numerico tra 0 e 1', function () {",
              "  pm.expect(body).to.have.property('score');",
              "  pm.expect(body.score).to.be.a('number');",
              "  pm.expect(body.score).to.be.at.least(0);",
              "  pm.expect(body.score).to.be.at.most(1);",
              "});",
              "",
              "pm.test('File annotato - timestamp numerico', function () {",
              "  pm.expect(body).to.have.property('timestamp');",
              "  pm.expect(body.timestamp).to.be.a('number');",
              "});",
              "",
              "pm.test('File annotato - models e\\' un array non vuoto', function () {",
              "  pm.expect(body).to.have.property('models');",
              "  pm.expect(body.models).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('File annotato - ogni model ha i campi attesi', function () {",
              "  body.models.forEach(function (m) {",
              "    pm.expect(m).to.have.property('name');",
              "    pm.expect(m).to.have.property('score');",
              "    pm.expect(m).to.have.property('has_annotations');",
              "    pm.expect(m).to.have.property('raw_properties_count');",
              "    pm.expect(m).to.have.property('valid_properties_count');",
              "    pm.expect(m).to.have.property('invalid_properties_count');",
              "    pm.expect(m).to.have.property('properties');",
              "    pm.expect(m.properties).to.be.an('array');",
              "  });",
              "});",
              "",
              "pm.test('File annotato - almeno un model con has_annotations=true', function () {",
              "  var annotated = body.models.filter(function (m) { return m.has_annotations === true; });",
              "  pm.expect(annotated.length, 'atteso almeno un model annotato').to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "contentType": "application/yaml",
              "src": "fixtures/annotated.yaml"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/semantic-score",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "semantic-score"
          ]
        },
        "description": "Carica un OpenAPI 3.0 annotato (x-jsonld-type / x-jsonld-context) e verifica il calcolo dello score."
      },
      "response": []
