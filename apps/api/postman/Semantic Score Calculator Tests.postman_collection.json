    {
      "name": "api istat - disabilitazione swagger in produzione",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Swagger UI - disabilitato in produzione (non 200, atteso 404)', function () {",
              "  pm.expect(pm.response.code, 'in produzione la Swagger UI deve essere disabilitata').to.not.eql(200);",
              "});",
              "",
              "// Verifica accessoria: lo spec OpenAPI resta servito anche in produzione.",
              "var base = pm.variables.get('baseUrl');",
              "pm.sendRequest({ url: base + '/openapi.yaml', method: 'GET' }, function (err, res) {",
              "  pm.test('OpenAPI spec (openapi.yaml) accessibile - status 200', function () {",
              "    pm.expect(err).to.be.null;",
              "    pm.expect(res.code).to.eql(200);",
              "  });",
              "});"
            ]
          }
        }
      ],
